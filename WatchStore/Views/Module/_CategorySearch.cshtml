@model IEnumerable<WatchStore.Models.MCategory>
<div class="categorys-product-search">
    @using (Html.BeginForm("Search", "Site", FormMethod.Get, new { @class = "search-form-cat" }))
    {
        <div class="input-group" style="width:100%">
            <input type="text" class="form-control" placeholder="Nhập tên sản phẩm..." name="key" value="@(Session["keywords"] ?? "")">
            <span class="input-group-btn">
                <button class="btn btn-primary" value="Search" name="s" type="submit">Tìm kiếm</button>
            </span>
        </div>
    }
</div>
<style>
    /* Ưu tiên responsive cho ô tìm kiếm trong header */
    .search-form-cat { width: 100%; }
    @@media (max-width: 767px) {
        .categorys-product-search { margin-top: 8px; }
        .categorys-product-search .input-group .btn { white-space: nowrap; }
    }
</style>